# NDAC project .gitignore. Default stance: code, configs and docs are tracked;
# DATA, MODELS, REPORTS and CREDENTIALS are not. To track a small, cleared file
# deliberately (e.g. a lookup table), add a "!path/to/file" exception below and
# note why in PROGRESS_REPORT.md. Never use "git add -f" to sneak data in.

# --- Credentials: non-negotiable, keep first ---
.env
.env.*
!.env.example
.ee_auth/
.ee_accounts/
.ee_personal_account/
.gcloud_config/
**/credentials
*credentials*.json
*service-account*.json
*-key.json
*.pem
*.key

# --- Data folders (folder structure kept via .gitkeep) ---
data/**
!data/**/
!data/**/.gitkeep
!data/raw/README.md
logs/**
slurm-*.out
!logs/**/
!logs/.gitkeep
/outputs/
/results/
/figures/
/models/
/checkpoints/
/runs/

# --- Dated reports: can contain field-level tables -> never committed ---
report/**
!report/**/
!report/**/.gitkeep

# --- Data / model file types anywhere in the tree ---
# tables
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.parquet
*.feather
*.sav
*.dta
*.rds
*.RData
*.sqlite
*.db
*.mdb
*.accdb
# vector GIS (shapefile parts, GeoJSON, KML, GeoPackage, file geodatabases)
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.qix
*.geojson
*.kml
*.kmz
*.gpkg
*.gdb/
# raster / point cloud / arrays
*.tif
*.tiff
*.jp2
*.img
*.nc
*.h5
*.hdf
*.zarr/
*.las
*.laz
*.npy
*.npz
# models
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
# archives
*.zip
*.rar
*.7z
*.tar
*.gz

# --- Environments & caches ---
.venv/
venv/
.deps/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
node_modules/

# --- OS / editor artifacts ---
Thumbs.db
Desktop.ini
~$*

# --- Machine-local Claude Code state (.claude/settings.json IS tracked) ---
.claude/settings.local.json
.claude/*.lock
