%% Training overview. Edit, then re-render (see docs/training/README.md).
%% Install route: git clone from GitHub + install.ps1 (personal skills). If the plugin moves
%% to gitlab.usask.ca later, step 2 becomes the two /plugin commands from README.md.
flowchart TB
  subgraph ROW1["GET READY · once per person"]
  direction LR
    subgraph S1["1 · INSTALL THE TOOLS"]
      direction TB
      A1["Install <b>git</b>, <b>VS Code</b><br/>and <b>Python</b>"] --> A2["VS Code → Extensions →<br/>install <b>Claude Code</b>"] --> A3["Sign in to Claude<br/>with your <b>USask account</b>"] --> A4["Set your git name and email<br/><i>git config --global user.name</i><br/><i>git config --global user.email</i>"]
    end
    subgraph S2["2 · INSTALL NDAC-FOUNDATION"]
      direction TB
      B1["Create a <b>GitHub</b> account and<br/>ask Thuan for an invite to<br/><b>thuanhavan/ndac-foundation</b>"] --> B2["Create <b>C:\&lt;NSID&gt;\Projects</b>, then in<br/>VS Code → Terminal → New Terminal:<br/><i>cd C:\&lt;NSID&gt;\Projects</i><br/><i>git clone https://github.com/thuanhavan/ndac-foundation</i>"] --> B3["Run the installer:<br/><i>powershell -ExecutionPolicy Bypass</i><br/><i>-File ndac-foundation/install.ps1</i>"] --> B4["Updates later: in that folder run<br/><i>git pull</i><br/>then run install.ps1 again"]
    end
    subgraph S3["3 · OPEN YOUR WORKSPACE"]
      direction TB
      C1["First time only, in the terminal:<br/><i>setx PROJECTS_ROOT C:\&lt;NSID&gt;\Projects</i><br/>then restart VS Code"] --> C2["VS Code → File → <b>Open Folder</b><br/>→ C:\&lt;NSID&gt;\Projects"] --> C3["Open Claude: click the<br/><b>Claude icon</b> in the sidebar"] --> C4["Check the skills loaded:<br/>type <b>/</b> and look for<br/><i>init-data-project</i>, <i>export-check</i>"]
    end
    S1 ==> S2 ==> S3
  end

  subgraph ROW2["EVERY PROJECT"]
  direction LR
    subgraph S4["4 · START A PROJECT"]
      direction TB
      D1["Ask Claude:<br/><i>“Start a new project<br/>called wetland_mb”</i>"] --> D2["File → Open Folder →<br/><b>C:\&lt;NSID&gt;\Projects\wetland_mb</b><br/>(Claude now reads its CLAUDE.md)"] --> D3["Ask Claude to run<br/><b>init_project.ps1</b><br/>(git + NDAC push guard)"] --> D4["Fill CLAUDE.md: purpose,<br/>security zone, data steward"]
    end
    subgraph S5["5 · PLAN THE RESEARCH"]
      direction TB
      E1["<b>objectives.md</b><br/>questions, hypotheses,<br/>key metric fixed in advance"] --> E2["<b>plan.md</b> + pipeline<br/>and Gantt diagrams<br/>(Claude drafts them)"] --> E3["Register every input in<br/><b>data_sources.md</b><br/>(provider, licence, zone)"]
    end
    subgraph S6["6 · ANALYSE"]
      direction TB
      F1["Ask Claude:<br/><i>“Add a sub-project<br/>called et_mapping”</i>"] --> F2["Ask Claude:<br/><i>“Make a v2 that<br/>adds Sentinel-2”</i><br/>(a version = a settings file)"] --> F3["Commit, then run:<br/>each run gets its own<br/>output folder"] --> F4["Log it: what changed,<br/>result, commit, keep / drop"]
    end
    subgraph S7["7 · SHARE RESULTS"]
      direction TB
      G1["Aggregate to RM or<br/>ecodistrict level<br/>(≥ 5 farms per cell)"] --> G2{{"<b>/export-check</b><br/>PASS or BLOCKED"}} --> G3["Acknowledge NDAC<br/>data and facilities"] --> G4["Paper · thesis · talk<br/>dataset deposit"]
    end
    S4 ==> S5 ==> S6 ==> S7
  end

  ROW1 ==> ROW2
  RULES["<b>Throughout:</b>&nbsp; data/raw is read-only &nbsp;·&nbsp; data never goes into git &nbsp;·&nbsp; commit at the end of each session<br/>log decisions in PROGRESS_REPORT.md &nbsp;·&nbsp; stuck? just ask Claude in plain words"]
  ROW2 ~~~ RULES

